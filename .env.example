# MongoDB Atlas. Leave empty to run on an in-memory MongoDB loaded with the labeled test fixture.
MONGODB_URI=
MONGODB_DB=bike
# local | atlas | elastic
SEARCH_BACKEND=local
ELASTIC_URL=
ELASTIC_API_KEY=
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-2026-03-05
# Repair intake uses one API call with medium reasoning effort.
OPENAI_DIAGNOSIS_MODEL=gpt-5.4-2026-03-05
# priority targets lower latency at a higher per-token rate; default uses standard pricing.
OPENAI_DIAGNOSIS_SERVICE_TIER=priority
LLM_MODEL_SMALL=claude-haiku-4-5
LLM_MODEL_LARGE=claude-opus-5
# Used only when OPENAI_API_KEY is set. Without it, vector search is skipped.
EMBEDDING_MODEL=text-embedding-3-small
# 0 to 1. Share of the question's meaningful words a manual passage must cover before Bike will answer.
REFUSAL_THRESHOLD=0.5
PORT=3000
SHOP_HOURLY_RATE=90
