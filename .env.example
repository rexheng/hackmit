# Maps: if set, the vicinity stage uses Google Maps JS API.
# Without it, Esri World Imagery + OSM labels still render a real satellite neighborhood map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Civic mail. The /api/mail route sends when one of these is present.
RESEND_API_KEY=
RESEND_FROM=Compute Works <works@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Extra demo recipient (in addition to constructed representative addresses).
DEMO_MAIL_TO=

# Optional: allow the citizen to add one more To: address from the form.
ALLOW_CUSTOM_RECIPIENT=true
